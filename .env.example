# Server
PORT=3000
NODE_ENV=development

# Where the SQLite database file lives. Relative paths resolve from the repo root.
DATABASE_PATH=./data/chatbot.db

# ---------------------------------------------------------------------------
# Model provider
# ---------------------------------------------------------------------------
# Which adapter the chat endpoint uses:
#   mock              - canned streaming replies, no API key needed (default)
#   anthropic         - Claude via the official SDK
#   openai-compatible - anything speaking POST /chat/completions: OpenAI,
#                       OpenRouter, Groq, Together, DeepSeek, Ollama, LM Studio
AI_PROVIDER=mock

# Credentials for the selected provider. Never commit the real values.
AI_API_KEY=

# Model used when a request does not map to something in AI_MODEL_MAP.
AI_MODEL=gpt-4o-mini

# openai-compatible only. Pick the vendor by changing this URL:
#   OpenAI      https://api.openai.com/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Groq        https://api.groq.com/openai/v1
#   DeepSeek    https://api.deepseek.com/v1
#   Ollama      http://localhost:11434/v1     (leave AI_API_KEY empty)
#   LM Studio   http://localhost:1234/v1      (leave AI_API_KEY empty)
AI_BASE_URL=https://api.openai.com/v1

# Maps the frontend model-picker labels to real model ids. Unmapped labels fall
# back to AI_MODEL. Example for OpenRouter, which serves every listed vendor:
# AI_MODEL_MAP={"ChatBot AI":"openai/gpt-4o-mini","GPT-4o":"openai/gpt-4o","Gemini":"google/gemini-2.0-flash-001","Claude":"anthropic/claude-sonnet-4.5","DeepSeek":"deepseek/deepseek-chat"}
AI_MODEL_MAP=

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
