# Server
PORT=3000
NODE_ENV=development

# Where the SQLite database file lives. Relative paths resolve from the repo root.
# Only used by the local Express server (src/). The Vercel deployment is
# stateless and keeps nothing on disk.
DATABASE_PATH=./data/chatbot.db

# ---------------------------------------------------------------------------
# The free tier: SpaceBunny Free MAX
# ---------------------------------------------------------------------------
# This is what answers when the visitor does not bring their own key, so it is
# the only setting most deployments need. Public users never supply a key.
#
# AI_PROVIDER is normally left EMPTY, which auto-selects:
#   AI_API_KEY set     -> openai-compatible, pointed at the Space Bunny route
#   AI_API_KEY empty   -> mock (canned replies) so a fresh clone runs offline
#
# Set it explicitly only to override the auto-selection (e.g. `anthropic`).
#
#   mock              canned streaming replies, no API key needed
#   anthropic         Claude via the official SDK
#   openai-compatible anything speaking POST /chat/completions
AI_PROVIDER=

# The deployment's own key for the free tier. Visitors never see or send this.
# Every documented Space Bunny route requires a key: there is no anonymous
# public endpoint. Free tiers are typically limited to a handful of requests
# per minute per account, so size CHAT_RATE_LIMIT_* to match before opening
# this to the public.
AI_API_KEY=

# Model id for the free tier. Space Bunny Alpha has a 1,000,000-token input
# context and returns up to 524,288 output tokens; the backend never truncates
# the conversation itself, it just sends the most recent turns.
AI_MODEL=stealth/space-bunny-alpha

# Base URL. OpenRouter serves Space Bunny Alpha and speaks the standard
# /chat/completions shape, so it reuses the openai-compatible adapter:
#   OpenRouter   https://openrouter.ai/api/v1
#   BeatAPI      https://api.beatapi.io/v1          (model: space-bunny-alpha)
#   OpenAI       https://api.openai.com/v1
#   Groq         https://api.groq.com/openai/v1
#   DeepSeek     https://api.deepseek.com/v1
#   Ollama       http://localhost:11434/v1          (leave AI_API_KEY empty)
#   LM Studio    http://localhost:1234/v1           (leave AI_API_KEY empty)
AI_BASE_URL=https://openrouter.ai/api/v1

# Reasoning effort, sent upstream as `reasoning: { effort }`.
# One of: low, medium, high, xhigh, max. Leave EMPTY to omit the field —
# gateways that do not recognise it reject the whole request.
AI_REASONING_EFFORT=

# Overrides the adapter's built-in assistant prompt. Leave empty for the default.
AI_SYSTEM_PROMPT=

# Maps frontend model-picker labels to real model ids for the default provider.
# Unmapped labels fall back to AI_MODEL.
# AI_MODEL_MAP={"GPT-4o":"openai/gpt-4o","Gemini":"google/gemini-3.8-flash","Claude":"anthropic/claude-opus-5"}
AI_MODEL_MAP=

# ---------------------------------------------------------------------------
# Bring your own key (BYOK)
# ---------------------------------------------------------------------------
# The picker labels GPT-4o, Gemini, Claude, DeepSeek and Groq do NOT use the
# values above. Each is a built-in preset (see src/providers/presets.ts) and
# expects the caller to send their own key with the request:
#
#   X-Provider-Key       required   the user's API key
#   X-Provider-Base-Url  optional   overrides the preset base URL
#   X-Provider-Model     optional   overrides the preset model id
#
# These headers are ignored for the default model, and the key is held only for
# the duration of the request: it is never written to the database, never
# logged, and never returned in an error or response.

# ---------------------------------------------------------------------------
# Rate limiting for POST /api/chat
# ---------------------------------------------------------------------------
# Every turn can spend money on the server's key, so each browser/account
# (owner) and each IP gets a fixed number of turns per window. Over the cap
# the API answers 429 {"code":"rate_limited"} with a Retry-After header.
# Per-IP is looser because an office or campus often shares one address.
CHAT_RATE_LIMIT_WINDOW_MS=60000
CHAT_RATE_LIMIT_PER_OWNER=20
CHAT_RATE_LIMIT_PER_IP=60

# Comma-separated origins allowed to call the API from a browser.
# Any origin listed here may send the BYOK headers, so keep the list tight.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ---------------------------------------------------------------------------
# Reverse proxies
# ---------------------------------------------------------------------------
# How much of X-Forwarded-For to trust when resolving req.ip. Off by default,
# and that default matters: any value above zero makes Express believe a header
# the client controls, so a visitor could forge a new IP on every request and
# walk straight through the per-IP rate limit.
#
# Set this ONLY when the app genuinely sits behind a proxy you control, then use
# the number of proxies in front of it (Vercel and a single nginx: `1`).
#
#   TRUST_PROXY=0        off (default; req.ip is the socket address)
#   TRUST_PROXY=1        trust exactly one hop
#   TRUST_PROXY=loopback trust loopback addresses only
TRUST_PROXY=0