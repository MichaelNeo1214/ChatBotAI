# Server
PORT=3000
NODE_ENV=development

# Where the SQLite database file lives. Relative paths resolve from the repo root.
DATABASE_PATH=./data/chatbot.db

# ---------------------------------------------------------------------------
# Default model provider (the "ChatBot AI" option in the model picker)
# ---------------------------------------------------------------------------
# Which adapter answers requests that do not bring their own key:
#   mock              - canned streaming replies, no API key needed (default)
#   anthropic         - Claude via the official SDK
#   openai-compatible - anything speaking POST /chat/completions: OpenAI,
#                       OpenRouter, Groq, Together, DeepSeek, Ollama, LM Studio
AI_PROVIDER=mock

# Credentials for the selected provider. Never commit the real values.
# Only used for the default model; user keys arrive per request and are not
# stored or logged. See the BYOK section below.
AI_API_KEY=

# Model used when a request does not map to something in AI_MODEL_MAP.
AI_MODEL=gpt-4o-mini

# openai-compatible only. Pick the vendor by changing this URL:
#   OpenAI      https://api.openai.com/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Groq        https://api.groq.com/openai/v1
#   DeepSeek    https://api.deepseek.com/v1
#   Ollama      http://localhost:11434/v1     (leave AI_API_KEY empty)
#   LM Studio   http://localhost:1234/v1      (leave AI_API_KEY empty)
AI_BASE_URL=https://api.openai.com/v1

# Maps the frontend model-picker labels to real model ids for the default
# provider. Unmapped labels fall back to AI_MODEL. Example for OpenRouter,
# which serves every listed vendor:
# AI_MODEL_MAP={"ChatBot AI":"openai/gpt-4o-mini","GPT-4o":"openai/gpt-4o","Gemini":"google/gemini-2.0-flash-001","Claude":"anthropic/claude-sonnet-4.5","DeepSeek":"deepseek/deepseek-chat"}
AI_MODEL_MAP=

# ---------------------------------------------------------------------------
# Bring your own key (BYOK)
# ---------------------------------------------------------------------------
# The picker labels GPT-4o, Gemini, Claude and DeepSeek do NOT use the values
# above. Each is a built-in preset (see src/providers/presets.ts) and expects
# the caller to send their own key with the request:
#
#   X-Provider-Key       required   the user's API key
#   X-Provider-Base-Url  optional   overrides the preset base URL
#   X-Provider-Model     optional   overrides the preset model id
#
# These headers are ignored for the default "ChatBot AI" model, and the key is
# held only for the duration of the request: it is never written to the
# database, never logged, and never returned in an error or response.

# Comma-separated origins allowed to call the API from a browser.
# Any origin listed here may send the BYOK headers, so keep the list tight.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
